+	void InterpreterUnitTests::testBoundedDoTwoWordEnd()
+	{
+		const auto savedConfig = dsp.getJit().getConfig();
+		for(const auto slice : {1u, 2u, 4u, 8u, 16u})
+		{
+			dsp.resetHW();
+			auto config = savedConfig;
+			config.maxDoIterations = slice;
+			dsp.getJit().setConfig(config);
+			auto pc = emitToMemory("jsr $200", 0x100);
+			const auto returnPC = pc;
+			emitToMemory("nop", returnPC);
+			pc = emitToMemory("do #$3,>$205", 0x200);
+			pc = emitToMemory("nop", pc);
+			// The extension word, not the opcode word, is at LA ($204).
+			pc = emitToMemory("move #>$123456,x0", pc);
+			verify(pc == 0x205);
+			emitToMemory("rts", pc);
+			dsp.setPC(0x100);
+			dsp.execInterpreter(); // JSR
+			const auto callSP = dsp.readRegs().sp.var;
+			dsp.execInterpreter(); // DO
+			for(unsigned iteration = 0; iteration < 3; ++iteration)
+			{
+				dsp.execInterpreter(); // NOP
+				dsp.execInterpreter(); // two-word MOVE
+				verify(dsp.getPC().toWord() == (iteration < 2 ? 0x202 : 0x205));
+			}
+			verify(dsp.getPC().toWord() == 0x205);
+			verify(dsp.readRegs().sp.var == callSP);
+			verify(!dsp.sr_test(SR_LF));
+			dsp.execInterpreter();
+			verify(dsp.getPC().toWord() == returnPC);
+
+			// Nested loops must pop their own two stack entries. Exercise the
+			// scheduler-facing exec() as well as the instruction-step path above.
+			dsp.resetHW();
+			emitToMemory("jsr $200", 0x100);
+			pc = emitToMemory("do #$2,>$209", 0x200);
+			pc = emitToMemory("do #$3,>$207", pc);
+			pc = emitToMemory("nop", pc);
+			pc = emitToMemory("move #>$123456,x0", pc);
+			verify(pc == 0x207);
+			pc = emitToMemory("move #>$654321,y0", pc);
+			verify(pc == 0x209);
+			emitToMemory("rts", pc);
+			dsp.setPC(0x100);
+			dsp.execInterpreter();
+			dsp.execInterpreter();
+			const auto bodyInstructions = dsp.getInstructionCounter();
+			for(unsigned calls = 0; calls < 32 && dsp.getPC().toWord() != 0x209; ++calls)
+				dsp.exec();
+			verify(dsp.getPC().toWord() == 0x209);
+			verify(dsp.getInstructionCounter() - bodyInstructions == 16);
+			verify(dsp.readRegs().sp.var == callSP);
+			verify(!dsp.sr_test(SR_LF));
+			dsp.execInterpreter();
+			verify(dsp.getPC().toWord() == returnPC);
+
+			// Returning to LA+1 from elsewhere is not execution of the loop's
+			// final instruction. Preserve the original epilogue's RTI guard.
+			dsp.resetHW();
+			emitToMemory("do #$3,>$205", 0x200);
+			emitToMemory("rti", 0x300);
+			dsp.setPC(0x200);
+			dsp.execInterpreter();
+			const auto loopSP = dsp.readRegs().sp.var;
+			dsp.setPC(0x205);
+			dsp.pushPCSR();
+			dsp.sr_clear(SR_LF);
+			dsp.setPC(0x300);
+			dsp.execInterpreter();
+			verify(dsp.getPC().toWord() == 0x205);
+			verify(dsp.readRegs().sp.var == loopSP);
+			verify(dsp.readRegs().lc.var == 3);
+			verify(dsp.sr_test(SR_LF));
+		}
+		dsp.getJit().setConfig(savedConfig);
+		dsp.resetHW();
+	}
